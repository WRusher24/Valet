{
  "name": "valet",
  "version": "1.0.0",
  "private": true,
  "description": "Valet — a men's office & smart-casual colour-combination lookbook.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx scripts/seed.ts",
    "db:check-images": "tsx scripts/check-images.ts",
    "db:setup": "tsx scripts/migrate.ts && tsx scripts/seed.ts",
    "vercel-build": "npm run db:setup && next build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@neondatabase/serverless": "^1.2.1",
    "@vercel/blob": "^2.9.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "next": "^15.5.29",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
